{
  "manifestVersion": 2,
  "id": "mention-sample",
  "name": {
    "en": "Mention Sample",
    "zh-CN": "提及示例"
  },
  "version": "1.0.0",
  "description": {
    "en": "Minimal Host extension with Web @ mention sources.",
    "zh-CN": "带 Web @ 提及来源的最小 Host 扩展。"
  },
  "backend": {
    "apiVersion": 1,
    "entry": "backend/index.mjs"
  },
  "mentions": {
    "apiVersion": 1,
    "sources": [
      {
        "id": "demo",
        "label": {
          "en": "Demo mentions",
          "zh-CN": "示例提及"
        }
      },
      {
        "id": "two-step",
        "label": {
          "en": "Two-step picker",
          "zh-CN": "两步选择"
        },
        "picker": true
      },
      {
        "id": "multi",
        "label": {
          "en": "Multiple mentions",
          "zh-CN": "多选提及"
        },
        "picker": true
      }
    ]
  },
  "web": {
    "apiVersion": 1,
    "entry": "web/index.mjs",
    "style": "web/style.css"
  }
}
